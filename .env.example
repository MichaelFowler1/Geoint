# --- OpenAI: scene assessment + SITREP ("the rest") ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_REPORT_MODEL=gpt-4o

# --- OpenSky: live ADS-B feed. Register a free account for OAuth2 client creds.
# Anonymous access works but is heavily rate-limited.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Feed bounding box: min_lat,max_lat,min_lon,max_lon  (default: DC area)
TRACK_BBOX=38.7,39.1,-77.3,-76.8
TRACK_POLL_SECONDS=12

# --- Detector: runs on the RTX 3080. 'auto' uses CUDA when available.
# The aerial fine-tune from this repo's release (python fetch_detector.py),
# or any Hugging Face object-detection id pinned to a commit with
# DETECTOR_REVISION (e.g. PekingU/rtdetr_r50vd, trained on everyday photos).
DETECTOR_MODEL=models/rtdetr-dota-v1
DETECTOR_REVISION=df939e661d8c52e80608d1ec566561aabd25a4e7
DETECTOR_DEVICE=auto
DETECTION_CONF=0.25
# Large scenes are cut into overlapping tiles at full resolution (0 = off).
DETECTOR_TILE=640
DETECTOR_TILE_OVERLAP=160

# --- Storage: PostGIS if set, else a local SQLite file.
# DATABASE_URL=postgresql://geoint:geoint@db:5432/geoint
DATABASE_URL=
