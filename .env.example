# --- OpenAI: scene assessment + SITREP ("the rest") ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_REPORT_MODEL=gpt-4o

# --- OpenSky: live ADS-B feed. Register a free account for OAuth2 client creds.
# Anonymous access works but is heavily rate-limited.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Feed bounding box: min_lat,max_lat,min_lon,max_lon  (default: DC area)
TRACK_BBOX=38.7,39.1,-77.3,-76.8
TRACK_POLL_SECONDS=12

# --- Detector: runs on the RTX 3080. 'auto' uses CUDA when available.
DETECTOR_MODEL=rtdetr-l.pt
DETECTOR_DEVICE=auto
DETECTION_CONF=0.25

# --- Storage: PostGIS if set, else a local SQLite file.
# DATABASE_URL=postgresql://geoint:geoint@db:5432/geoint
DATABASE_URL=
